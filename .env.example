# COZLY (cozly.in) Environment Configuration
# Copy this file to .env.local to configure your production Supabase database

# 1. Supabase Project Credentials (from https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Public Site URL
NEXT_PUBLIC_SITE_URL=https://cozly.in

# 3. WhatsApp Dispatch Number (Also configurable from /admin/settings)
NEXT_PUBLIC_WHATSAPP_NUMBER=+919846581241
